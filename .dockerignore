#==============================================================================
# DOCKER BUILD CONTEXT EXCLUSIONS
#==============================================================================
# Keep the build context minimal — only what `npm run build` actually needs.
#------------------------------------------------------------------------------

# Dependencies & build output (rebuilt inside the image)
node_modules
.next
out

# VCS, CI & infrastructure (not needed inside the image)
.git
.github
deploy

# Environment & local files — secrets must never enter the image
.env*
!.env.example
*.log
.DS_Store

# Documentation
*.md
