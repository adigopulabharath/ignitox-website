#==============================================================================
# ENVIRONMENT VARIABLES — EXAMPLE
#==============================================================================
# Copy to `.env.local` for development or `/opt/ignitox/.env` on the server.
# Never commit real values. NEXT_PUBLIC_* values are inlined into the client
# bundle at build time — never put secrets in them.
#------------------------------------------------------------------------------

#------------------------------------------------------------------------------
# SITE
#------------------------------------------------------------------------------
# Canonical public origin (no trailing slash). Used for metadata, sitemap,
# robots.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://ignitox.com

#------------------------------------------------------------------------------
# CLOUDFLARE TURNSTILE (free anti-bot for the contact form)
#------------------------------------------------------------------------------
# Create a widget at https://dash.cloudflare.com → Turnstile. If unset, the
# widget is hidden and server-side verification is skipped (dev convenience —
# always set both in production).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

#------------------------------------------------------------------------------
# CONTACT FORM EMAIL DELIVERY (Resend free tier — https://resend.com)
#------------------------------------------------------------------------------
# If unset, submissions are logged to stdout instead of emailed (dev only).
# CONTACT_FROM_EMAIL must belong to a domain verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@ignitox.com
CONTACT_FROM_EMAIL=Ignitox Website <noreply@ignitox.com>

# Newsletter audience (Resend dashboard -> Audiences). If unset, signups are
# logged to stdout instead (dev only).
RESEND_AUDIENCE_ID=

#------------------------------------------------------------------------------
# PAYLOAD CMS (admin panel at /admin)
#------------------------------------------------------------------------------
# Cookie/token signing secret. Required in production; generate with:
#   openssl rand -hex 32
PAYLOAD_SECRET=

# SQLite location. Default works in Docker (persisted ./data volume) and dev.
# DATABASE_URI=file:./data/ignitox.db

# First admin account created by `npm run seed` when no users exist.
# Change the password immediately after first login.
SEED_ADMIN_EMAIL=admin@ignitox.com
SEED_ADMIN_PASSWORD=
